<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

:root {
  --bg-primary: #fdf8f0;
  --bg-secondary: #f5ebd8;
  --bg-card: #ffffff;
  --bg-card-hover: #faf0db;
  --accent: #8b1538;
  --accent-dark: #6b0f2a;
  --accent-dim: rgba(139,21,56,0.08);
  --accent-border: rgba(139,21,56,0.20);
  --text-primary: #2a1418;
  --text-muted: #6b4750;
  --text-faint: #a88a8e;
  --border: rgba(139,21,56,0.14);
  --container: 1300px;
  --gap: 140px;
  --radius: 18px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', system-ui, sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.8;
  font-size: 16px;
  min-width: 320px;
}

.container {
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 24px;
}

/* ─── TICKER ─── */
.ticker-wrap {
  background: var(--accent);
  color: #fff;
  overflow: hidden;
  height: 36px;
  display: flex;
  align-items: center;
}
.ticker-track {
  display: flex;
  white-space: nowrap;
  animation: ticker-scroll 38s linear infinite;
}
.ticker-track span {
  font-size: 0.78rem;
  font-weight: 500;
  padding: 0 48px;
  letter-spacing: 0.04em;
}
.ticker-track span::before { content: "◆  "; }
@keyframes ticker-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ─── HEADER ─── */
#site-header {
  position: sticky;
  top: 0;
  z-index: 900;
  background: var(--bg-primary);
  border-bottom: 2px solid var(--text-primary);
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 24px;
  max-width: var(--container);
  margin: 0 auto;
}
.logo {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text-primary);
  text-decoration: none;
  letter-spacing: -0.02em;
}
.logo span { color: var(--accent); }
nav.main-nav { display: flex; align-items: center; gap: 28px; }
nav.main-nav a {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--text-muted);
  text-decoration: none;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  transition: color .2s;
}
nav.main-nav a:hover { color: var(--accent); }
.nav-cta {
  background: var(--accent);
  color: #fff !important;
  padding: 8px 20px;
  border-radius: 999px;
  font-size: 0.82rem !important;
  transition: background .2s !important;
}
.nav-cta:hover { background: var(--accent-dark) !important; }
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  background: none;
  border: none;
  padding: 4px;
}
.hamburger span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--text-primary);
  transition: .3s;
}
.mobile-nav {
  display: none;
  flex-direction: column;
  gap: 0;
  background: var(--bg-secondary);
  border-top: 1px solid var(--border);
}
.mobile-nav.open { display: flex; }
.mobile-nav a {
  padding: 14px 24px;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text-primary);
  text-decoration: none;
  border-bottom: 1px solid var(--border);
  transition: background .2s;
}
.mobile-nav a:hover { background: var(--accent-dim); }

/* ─── HERO ─── */
#hero {
  background: var(--bg-secondary);
  border-bottom: 3px solid var(--text-primary);
  padding: 72px 0 0;
}
.hero-inner {
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 24px;
}
.hero-eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 18px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.hero-eyebrow::before {
  content: "";
  display: inline-block;
  width: 32px;
  height: 2px;
  background: var(--accent);
}
h1.speakable {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 2.8rem;
  font-weight: 700;
  line-height: 1.18;
  color: var(--text-primary);
  max-width: 820px;
  margin-bottom: 24px;
  letter-spacing: -0.02em;
}
.hero-lead {
  font-size: 1.05rem;
  color: var(--text-muted);
  max-width: 620px;
  margin-bottom: 36px;
  line-height: 1.85;
}
.cta-gradient-pill {
  display: inline-block;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
  color: #fff;
  font-size: 0.95rem;
  font-weight: 600;
  padding: 14px 36px;
  border-radius: 999px;
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: opacity .2s, transform .2s;
  margin-bottom: 56px;
}
.cta-gradient-pill:hover { opacity: 0.88; transform: translateY(-2px); }
.hero-stats {
  display: flex;
  align-items: stretch;
  border-top: 2px solid var(--text-primary);
  margin-top: 0;
}
.stat-item {
  flex: 1;
  padding: 24px 28px;
  border-right: 1px solid var(--border);
}
.stat-item:last-child { border-right: none; }
.stat-value {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 2rem;
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
  margin-bottom: 6px;
}
.stat-label {
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 500;
}

/* ─── BREADCRUMB ─── */
.breadcrumb-nav {
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border);
  padding: 12px 0;
}
.breadcrumb-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
  list-style: none;
  font-size: 0.8rem;
  color: var(--text-faint);
}
.breadcrumb-list li { display: flex; align-items: center; gap: 6px; }
.breadcrumb-list a { color: var(--accent); text-decoration: none; }
.breadcrumb-list a:hover { text-decoration: underline; }
.breadcrumb-list li:not(:last-child)::after { content: "›"; color: var(--text-faint); }

/* ─── TOC ─── */
#toc {
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 32px 36px;
  margin: 56px auto;
  max-width: var(--container);
  width: calc(100% - 48px);
}
.toc-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 16px;
  color: var(--text-primary);
  border-bottom: 2px solid var(--text-primary);
  padding-bottom: 10px;
}
.toc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 40px;
}
.toc-grid a {
  font-size: 0.85rem;
  color: var(--text-muted);
  text-decoration: none;
  padding: 4px 0;
  border-bottom: 1px dotted var(--border);
  display: flex;
  align-items: center;
  gap: 8px;
  transition: color .2s;
}
.toc-grid a:hover { color: var(--accent); }
.toc-num {
  font-size: 0.7rem;
  color: var(--text-faint);
  font-weight: 600;
  min-width: 18px;
}

/* ─── SECTION COMMON ─── */
.section-wrap { padding: 80px 0; }
.section-wrap + .section-wrap { border-top: 3px solid var(--text-primary); }
.section-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-label::before {
  content: "";
  display: inline-block;
  width: 24px;
  height: 2px;
  background: var(--accent);
}
.section-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 2rem;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
  margin-bottom: 14px;
  letter-spacing: -0.01em;
}
.section-lead {
  font-size: 1rem;
  color: var(--text-muted);
  max-width: 680px;
  line-height: 1.85;
  margin-bottom: 48px;
}
.divider { height: 3px; background: var(--text-primary); margin: 0; }

/* ─── GIRIS ─── */
.giris-cols {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: start;
}
.giris-cols p {
  color: var(--text-muted);
  line-height: 1.85;
  margin-bottom: 18px;
  font-size: 0.97rem;
}
.giris-cols p:last-child { margin-bottom: 0; }
.giris-aside {
  background: var(--bg-secondary);
  border-left: 4px solid var(--accent);
  padding: 28px 28px;
  border-radius: 0 var(--radius) var(--radius) 0;
}
.giris-aside h3 {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.1rem;
  margin-bottom: 14px;
  color: var(--text-primary);
}
.giris-aside ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.giris-aside li {
  font-size: 0.88rem;
  color: var(--text-muted);
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.giris-aside li::before {
  content: "▸";
  color: var(--accent);
  flex-shrink: 0;
  margin-top: 2px;
}

/* ─── OZELLIKLER ─── */
.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border: 2px solid var(--text-primary);
  margin-bottom: 56px;
}
.feature-col {
  padding: 32px 32px;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  transition: background .2s;
}
.feature-col:hover { background: var(--bg-card-hover); }
.feature-col:nth-child(even) { border-right: none; }
.feature-col:nth-child(5),
.feature-col:nth-child(6) { border-bottom: none; }
.feature-roman {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.4rem;
  color: var(--accent);
  font-weight: 700;
  margin-bottom: 10px;
}
.feature-col h3 {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.05rem;
  color: var(--text-primary);
  margin-bottom: 10px;
}
.feature-col p {
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.75;
}

/* ─── KARSILASTIRMA TABLOSU ─── */
.compare-table-wrap { overflow-x: auto; }
.compare-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}
.compare-table th {
  background: var(--text-primary);
  color: var(--bg-primary);
  padding: 14px 18px;
  text-align: left;
  font-size: 0.78rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-weight: 600;
}
.compare-table td {
  padding: 14px 18px;
  border-bottom: 1px solid var(--border);
  color: var(--text-muted);
  vertical-align: top;
}
.compare-table tr:hover td { background: var(--accent-dim); }
.compare-table .check { color: var(--accent); font-weight: 700; }
.compare-table .cross { color: var(--text-faint); }

/* ─── NASIL ─── */
.steps-list { display: flex; flex-direction: column; gap: 0; }
.step-item {
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 0;
  border-bottom: 2px solid var(--border);
  padding: 36px 0;
}
.step-item:last-child { border-bottom: none; }
.step-roman {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 3rem;
  color: var(--accent);
  font-weight: 700;
  line-height: 1;
  padding-top: 4px;
}
.step-body h3 {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.15rem;
  color: var(--text-primary);
  margin-bottom: 10px;
}
.step-body p {
  font-size: 0.92rem;
  color: var(--text-muted);
  line-height: 1.8;
}

/* ─── GUVEN ─── */
.guven-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border: 2px solid var(--text-primary);
}
.guven-card {
  padding: 32px 28px;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  transition: background .2s;
}
.guven-card:hover { background: var(--bg-card-hover); }
.guven-card:nth-child(3n) { border-right: none; }
.guven-card:nth-child(4),
.guven-card:nth-child(5),
.guven-card:nth-child(6) { border-bottom: none; }
.guven-icon {
  font-size: 1.6rem;
  margin-bottom: 14px;
}
.guven-card h3 {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1rem;
  margin-bottom: 10px;
  color: var(--text-primary);
}
.guven-card p {
  font-size: 0.85rem;
  color: var(--text-muted);
  line-height: 1.75;
}

/* ─── SSS ACCORDION ─── */
.faq-list { display: flex; flex-direction: column; }
.faq-item { border-bottom: 2px solid var(--text-primary); }
.faq-question {
  width: 100%;
  background: none;
  border: none;
  text-align: left;
  padding: 22px 0;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-primary);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  transition: color .2s;
}
.faq-question:hover { color: var(--accent); }
.faq-indicator {
  font-size: 1.2rem;
  color: var(--accent);
  transition: transform .3s;
  flex-shrink: 0;
}
.faq-item.open .faq-indicator { transform: rotate(45deg); }
.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height .4s ease;
}
.faq-answer-inner {
  padding: 0 0 22px;
  font-size: 0.92rem;
  color: var(--text-muted);
  line-height: 1.85;
}

/* ─── VIDEO ─── */
.video-placeholder {
  aspect-ratio: 16/9;
  max-width: 720px;
  background: var(--bg-secondary);
  border: 2px solid var(--text-primary);
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18px;
  cursor: pointer;
  transition: background .2s;
  position: relative;
  overflow: hidden;
}
.video-placeholder:hover { background: var(--bg-card-hover); }
.play-icon {
  width: 72px;
  height: 72px;
  background: var(--accent);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .2s;
}
.video-placeholder:hover .play-icon { transform: scale(1.08); }
.play-icon svg { width: 28px; height: 28px; fill: #fff; margin-left: 4px; }
.video-meta { text-align: center; }
.video-meta h3 {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.05rem;
  color: var(--text-primary);
  margin-bottom: 6px;
}
.video-meta p { font-size: 0.82rem; color: var(--text-muted); }
.video-duration {
  position: absolute;
  bottom: 14px;
  right: 16px;
  background: var(--text-primary);
  color: var(--bg-primary);
  font-size: 0.75rem;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 4px;
}

/* ─── YORUMLAR ─── */
.reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border: 2px solid var(--text-primary);
}
.review-card {
  padding: 32px 28px;
  border-right: 1px solid var(--border);
  transition: background .2s;
}
.review-card:last-child { border-right: none; }
.review-card:hover { background: var(--bg-card-hover); }
.review-stars {
  color: var(--accent);
  font-size: 1rem;
  margin-bottom: 12px;
  letter-spacing: 2px;
}
.review-body {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.8;
  margin-bottom: 18px;
  font-style: italic;
}
.review-author {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-primary);
}
.review-date {
  font-size: 0.75rem;
  color: var(--text-faint);
  margin-top: 4px;
}
.rating-summary {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 40px;
  padding: 20px 24px;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  width: fit-content;
}
.rating-big {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 3rem;
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
}
.rating-info { display: flex; flex-direction: column; gap: 4px; }
.rating-stars-row { color: var(--accent); font-size: 1.1rem; letter-spacing: 2px; }
.rating-count { font-size: 0.8rem; color: var(--text-muted); }

/* ─── GUNCEL ADRES ─── */
#guncel-adres {
  background: var(--bg-secondary);
  border-top: 3px solid var(--text-primary);
  border-bottom: 3px solid var(--text-primary);
  padding: 80px 0;
  text-align: center;
}
.adres-box {
  display: inline-block;
  background: var(--bg-card);
  border: 2px solid var(--accent);
  border-radius: var(--radius);
  padding: 40px 56px;
  animation: pulse-ring 2.4s ease-in-out infinite;
}
@keyframes pulse-ring {
  0%, 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.0), 0 0 0 6px rgba(34,197,94,0.08); }
  50% { box-shadow: 0 0 0 10px rgba(34,197,94,0.12), 0 0 0 20px rgba(34,197,94,0.04); }
}
.adres-label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 16px;
}
.adres-url {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--accent);
  text-decoration: none;
  display: block;
  margin-bottom: 16px;
  word-break: break-all;
  transition: color .2s;
}
.adres-url:hover { color: var(--accent-dark); }
.adres-note {
  font-size: 0.82rem;
  color: var(--text-muted);
}
.adres-cta {
  display: inline-block;
  margin-top: 28px;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
  color: #fff;
  padding: 13px 34px;
  border-radius: 999px;
  font-size: 0.92rem;
  font-weight: 600;
  text-decoration: none;
  transition: opacity .2s, transform .2s;
}
.adres-cta:hover { opacity: 0.88; transform: translateY(-2px); }

/* ─── FOOTER ─── */
footer {
  background: var(--text-primary);
  color: var(--bg-secondary);
  padding: 56px 0 32px;
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 48px;
  margin-bottom: 40px;
}
.footer-brand p {
  font-size: 0.85rem;
  color: var(--text-faint);
  line-height: 1.75;
  margin-top: 12px;
  max-width: 320px;
}
.footer-logo {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--bg-primary);
}
.footer-logo span { color: var(--accent); }
.footer-col h4 {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-faint);
  margin-bottom: 16px;
}
.footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.footer-col li a {
  font-size: 0.85rem;
  color: var(--bg-secondary);
  text-decoration: none;
  transition: color .2s;
}
.footer-col li a:hover { color: var(--accent); }
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.08);
  padding-top: 24px;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
.footer-bottom p { font-size: 0.78rem; color: var(--text-faint); }
.footer-bottom a {
  font-size: 0.78rem;
  color: var(--text-faint);
  text-decoration: none;
  transition: color .2s;
}
.footer-bottom a:hover { color: var(--accent); }
.footer-links { display: flex; gap: 18px; flex-wrap: wrap; }

/* ─── RESPONSIVE ─── */
@media (max-width: 1024px) {
  .footer-grid { grid-template-columns: 1fr 1fr; }
  .guven-grid { grid-template-columns: 1fr 1fr; }
  .guven-card:nth-child(3n) { border-right: 1px solid var(--border); }
  .guven-card:nth-child(2n) { border-right: none; }
  .guven-card:nth-child(3),
  .guven-card:nth-child(4) { border-bottom: 1px solid var(--border); }
  .guven-card:nth-child(5),
  .guven-card:nth-child(6) { border-bottom: none; }
}
@media (max-width: 768px) {
  h1.speakable { font-size: 2rem; }
  .section-title { font-size: 1.5rem; }
  .giris-cols { grid-template-columns: 1fr; gap: 32px; }
  .features-grid { grid-template-columns: 1fr; }
  .feature-col:nth-child(even) { border-right: 1px solid var(--border); }
  .feature-col:nth-child(5) { border-bottom: 1px solid var(--border); }
  .feature-col:nth-child(6) { border-bottom: none; }
  .guven-grid { grid-template-columns: 1fr; }
  .guven-card { border-right: none !important; }
  .guven-card:nth-child(n) { border-bottom: 1px solid var(--border); }
  .guven-card:last-child { border-bottom: none; }
  .reviews-grid { grid-template-columns: 1fr; }
  .review-card { border-right: none; border-bottom: 1px solid var(--border); }
  .review-card:last-child { border-bottom: none; }
  .hero-stats { flex-direction: column; }
  .stat-item { border-right: none; border-bottom: 1px solid var(--border); }
  .stat-item:last-child { border-bottom: none; }
  .toc-grid { grid-template-columns: 1fr; }
  .step-item { grid-template-columns: 56px 1fr; }
  .step-roman { font-size: 2rem; }
  .footer-grid { grid-template-columns: 1fr; gap: 32px; }
  nav.main-nav { display: none; }
  .hamburger { display: flex; }
  .adres-box { padding: 28px 24px; }
  .adres-url { font-size: 1.2rem; }
}
@media (max-width: 480px) {
  .features-grid { grid-template-columns: 1fr; }
  .container { padding: 0 16px; }
  #toc { padding: 24px 20px; width: calc(100% - 32px); }
}
</style>
</head>
