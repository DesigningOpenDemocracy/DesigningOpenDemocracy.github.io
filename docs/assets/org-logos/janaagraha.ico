<script defer>
(function() {
  // Accordion SSS
  var faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(function(item) {
    var btn = item.querySelector('.faq-question');
    var answer = item.querySelector('.faq-answer');
    btn.addEventListener('click', function() {
      var isOpen = item.classList.contains('open');
      faqItems.forEach(function(i) {
        i.classList.remove('open');
        i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
        i.querySelector('.faq-answer').style.maxHeight = '0';
      });
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }
    });
  });

  // Hamburger
  var hamburger = document.getElementById('hamburger-btn');
  var mobileNav = document.getElementById('mobile-nav');
  if (hamburger && mobileNav) {
    hamburger.addEventListener('click', function() {
      var expanded = hamburger.getAttribute('aria-expanded') === 'true';
      hamburger.setAttribute('aria-expanded', String(!expanded));
      mobileNav.classList.toggle('open', !expanded);
    });
  }

  // Dynamic JSON-LD update
  var wc = document.body.innerText.trim().split(/\s+/).filter(Boolean).length;
  var today = new Date().toISOString();
  var ldScript = document.getElementById('ld-json');
  if (ldScript) {
    try {
      var data = JSON.parse(ldScript.textContent);
      if (data['@graph'] && Array.isArray(data['@graph'])) {
        data['@graph'].forEach(function(node) {
          if (node['@type'] === 'WebPage') {
            node['dateModified'] = today;
          }
          if (node['@type'] === 'Article') {
            node['dateModified'] = today;
            node['wordCount'] = wc;
          }
          if (node['@type'] === 'NewsArticle') {
            node['dateModified'] = today;
          }
        });
      }
      ldScript.textContent = JSON.stringify(data);
    } catch(e) {}
  }
})();
</script>
</body>
</html>