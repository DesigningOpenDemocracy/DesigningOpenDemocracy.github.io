# Re-generated at every build from in-repo data:
# - events.json + calendar.ics are derived from docs/data/events/<slug>.json
#   (the committed iCal sync cache) so they don't need to be versioned.
# - citations.json is a read-only CSL-JSON projection of markdown quotes
#   plus docs/data/citation-evidence.json (both committed) — see
#   hooks/citation_export.py and CLAUDE.md's "Citation archival" section.
#   Was committed until 2026-08-22; stopped once citation_export.py
#   became a strict projection with zero information not already in the
#   two committed sources, at which point committing it was pure
#   regenerable-build-output noise with no upside, same as events.json.
manual-dump/
# Local working state for the manual page-dump workflow (see
# util/manual_dump.py) — human-saved browser snapshots for citation URLs
# no automated fetch can reach. Never committed: the durable, shareable
# archive of a citation is Wayback Machine, not this. util/import_manual_dump.py
# distills whatever's useful out of it into the committed evidence cache.
.pagecache/
# Local reading copies of cited pages, written through by
# util/check_fragments.py at fetch time (see util/pagecache.py) so a later
# human/AI session can re-read what a page said without re-pinging the site.
# Never committed — unlike manual-dump/ these pages ARE script-fetchable, so
# anyone can regenerate them locally with one `check_fragments --no-cache`
# run; verification state lives in the committed evidence cache either way.
